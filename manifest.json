{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Tab Harbor",
  "version": "3.19.0",
  "description": "__MSG_extDesc__",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "64": "icons/icon64.png",
    "128": "icons/icon128.png",
    "48": "icons/icon48.png"
  },
  "action": {
    "default_title": "Tab Harbor · 标签港湾",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "omnibox": {
    "keyword": "harbor"
  },
  "permissions": [
    "tabs",
    "storage",
    "unlimitedStorage",
    "favicon",
    "alarms",
    "tabGroups",
    "contextMenus",
    "sidePanel"
  ],
  "commands": {
    "save-current-window": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "__MSG_cmdSaveCurrent__"
    },
    "save-all-windows": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "__MSG_cmdSaveAll__"
    },
    "save-workspace": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "__MSG_cmdSaveWorkspace__"
    }
  },
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "default_locale": "zh_CN"
}
